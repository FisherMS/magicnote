{
    "name": "magicnote",
    "version": "3.0.0",
    "description": "MagicNote - Modern technical blog based on VitePress",
    "repository": {
        "type": "git",
        "url": "https://github.com/FisherMS/magicnote.git"
    },
    "main": "index.js",
    "author": {
        "name": "fisher",
        "email": "fisher@aicrosoft.com",
        "url": "https://aicrosoft.com/"
    },
    "homepage": "https://aicrosoft.com/",
    "keywords": [],
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "cross-env VITE_BLOG_THEME=default vitepress dev --host 0.0.0.0",
        "dev:minimal": "cross-env VITE_BLOG_THEME=minimal vitepress dev --host 0.0.0.0",
        "build": "cross-env VITE_BLOG_THEME=default vitepress build",
        "build:minimal": "cross-env VITE_BLOG_THEME=minimal vitepress build",
        "build:all": "pnpm run build && pnpm run build:minimal",
        "prod": "cross-env VITE_BLOG_THEME=default NODE_ENV=production vitepress build",
        "preview": "cross-env NODE_ENV=production vitepress preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \".vitepress/**/*.{ts,vue,json}\" \"tests/**/*.ts\"",
        "format:write": "pnpm run format",
        "format:check": "prettier --check \".vitepress/**/*.{ts,vue,json}\" \"tests/**/*.ts\"",
        "check:static": "pnpm run typecheck && pnpm run lint",
        "check:test": "pnpm run test",
        "check:all": "pnpm run check:static && pnpm run check:test && pnpm run build:all",
        "check:commit": "pnpm run format && pnpm run check:all",
        "precommit": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test",
        "verify": "pnpm run precommit",
        "ci": "pnpm run typecheck && pnpm run lint && pnpm run coverage && pnpm run build:all"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^26.6.4",
        "@typescript-eslint/eslint-plugin": "^8.51.0",
        "@typescript-eslint/parser": "^8.51.0",
        "@typescript-eslint/types": "^8.51.0",
        "@vitest/coverage-v8": "^5.0.3",
        "@vue/compiler-sfc": "^3.5.43",
        "cross-env": "^10.1.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-vue": "^10.11.0",
        "fs-extra": "^11.4.1",
        "globby": "^16.2.4",
        "gray-matter": "^4.0.3",
        "happy-dom": "^20.0.11",
        "medium-zoom": "^1.1.0",
        "prettier": "^3.9.8",
        "typescript": "^6.0.3",
        "vite": "^8.3.2",
        "vitepress": "^1.6.4",
        "vitepress-plugin-comment-with-giscus": "^1.1.15",
        "vitepress-plugin-mermaid": "^2.0.17",
        "vitepress-sidebar": "^1.33.1",
        "vitest": "^5.0.3"
    },
    "packageManager": "pnpm@10.27.0"
}